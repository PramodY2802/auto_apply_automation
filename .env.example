# ---- Core (required)
NODE_ENV=development
DATABASE_URL=postgresql://postgres@localhost:5432/autoapply
REDIS_URL=redis://localhost:6379
# AES-256-GCM keyring "id:base64key[,oldId:oldKey]". Generate: echo "k1:$(openssl rand -base64 32)"
ENCRYPTION_KEYS=
PORT=4000
WEB_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://localhost:4000     # used by the Next.js proxy
COOKIE_SECURE=false                        # must be true in production (HTTPS)
COOKIE_DOMAIN=
SESSION_TTL_DAYS=14
REQUIRE_EMAIL_VERIFICATION=false           # set true in production
MAX_UPLOAD_MB=10
RATE_LIMIT_PER_MINUTE=300
EXTENSION_ORIGINS=                         # e.g. chrome-extension://<id> (production)

# ---- Storage
STORAGE_DRIVER=local                       # local | s3
LOCAL_STORAGE_PATH=./storage
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=                               # MinIO / R2 / other S3-compatible endpoint
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- Email (dev logs emails when unset; set MAIL_LOG_BODIES=true to see links locally)
SMTP_URL=
MAIL_FROM=AutoApply <no-reply@localhost>
MAIL_LOG_BODIES=false

# ---- OCR
OCR_ENGINE=tesseract                       # tesseract | google-vision
TESSERACT_PATH=tesseract
GOOGLE_VISION_API_KEY=

# ---- AI providers: configured in the app (Super Admin → AI providers), keys stored encrypted.

# ---- Browser automation (workers)
CHROMIUM_PATH=                             # optional explicit Chromium binary
PLAYWRIGHT_BROWSERS_PATH=
BROWSER_MAX_CONCURRENCY=2
BROWSER_ALLOWED_HOSTS=                     # optional allow-list, e.g. localhost,sandbox
WORKER_QUEUES=                             # empty = all queues in one process

# ---- Integrations
SANDBOX_BOARD_URL=http://localhost:4100
SANDBOX_PORT=4100

# ---- Billing
PAYMENT_PROVIDER=manual                    # manual | stripe
STRIPE_SECRET_KEY=

# ---- Logging
LOG_LEVEL=info
