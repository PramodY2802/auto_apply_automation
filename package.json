{
  "name": "autoapply",
  "private": true,
  "version": "0.1.0",
  "description": "Multi-tenant AI job discovery, matching, auto-apply and application tracking platform",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r --filter ./packages/** run build && pnpm --filter @autoapply/api --filter @autoapply/workers --filter @autoapply/sandbox-board run build",
    "build:web": "pnpm --filter @autoapply/web run build",
    "build:all": "pnpm build && pnpm build:web",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r --filter ./packages/** run test && pnpm --filter @autoapply/api run test && pnpm --filter @autoapply/workers run test",
    "test:unit": "pnpm -r --filter ./packages/** run test",
    "test:integration": "pnpm --filter @autoapply/api run test",
    "test:e2e": "pnpm --filter @autoapply/workers run test:e2e",
    "db:generate": "pnpm --filter @autoapply/database run generate",
    "db:migrate": "pnpm --filter @autoapply/database run migrate",
    "db:seed": "pnpm --filter @autoapply/database run seed",
    "dev:api": "pnpm --filter @autoapply/api run dev",
    "dev:web": "pnpm --filter @autoapply/web run dev",
    "dev:workers": "pnpm --filter @autoapply/workers run dev",
    "dev:sandbox": "pnpm --filter @autoapply/sandbox-board run dev",
    "start:web": "pnpm --filter @autoapply/web run start"
  }
}
