{
  "name": "@autoapply/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch --env-file-if-exists=../../.env dist/main.js",
    "create-admin": "node --env-file-if-exists=../../.env dist/cli/create-admin.js",
    "openapi": "node --env-file-if-exists=../../.env dist/cli/openapi.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@autoapply/ai-providers": "workspace:*",
    "@autoapply/database": "workspace:*",
    "@autoapply/document-extraction": "workspace:*",
    "@autoapply/matching-engine": "workspace:*",
    "@autoapply/platform-integrations": "workspace:*",
    "@autoapply/services": "workspace:*",
    "@autoapply/shared": "workspace:*",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.4.0",
    "@node-rs/argon2": "^2.0.2",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@swc/core": "^1.11.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.1.0",
    "typescript": "^5.9.0",
    "unplugin-swc": "^1.5.0",
    "vitest": "^3.2.0"
  }
}
